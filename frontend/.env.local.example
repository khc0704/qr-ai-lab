# frontend/.env.local — copy to .env.local. Only server-side values; nothing here reaches the browser.
# Where the FastAPI backend is reachable from the Next.js server (not from the browser).
BACKEND_URL=http://localhost:8000

# --- Authentication ---------------------------------------------------------------------------
# local    = dev: username/password accounts seeded by the backend (superadmin / admin / user)
# keycloak = prod: company Keycloak through Auth.js; the backend must run with AUTH_MODE=keycloak too
AUTH_MODE=local
# Keycloak (only read when AUTH_MODE=keycloak). Keep the real values in your private .env.local.
#AUTH_SECRET=                      # openssl rand -base64 32 — encrypts the Auth.js session cookie
#AUTH_URL=https://qr-ai-lab.example.com   # public origin behind nginx (callback = $AUTH_URL/api/auth/callback/keycloak)
#AUTH_KEYCLOAK_ID=qr-ai-lab
#AUTH_KEYCLOAK_SECRET=
#AUTH_KEYCLOAK_ISSUER=https://sso.example.com/realms/<realm>
#AUTH_SESSION_MAX_AGE=43200        # seconds the Auth.js session cookie lives (tokens are refreshed inside it)
#AUTH_LOCAL_FALLBACK=0             # 1 = also show the local username/password form during the switch-over
