# /etc/qr-ai-lab/frontend.env — Next.js 前端（systemd EnvironmentFile）。只在伺服器端讀取，不會進瀏覽器。
# systemd 不接受值後面的 # 註解，所有說明都寫在獨立的行上。
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
BACKEND_URL=http://127.0.0.1:8000
# 與 qrlab.env 的 AUTH_MODE 一致：local（本地帳號）或 keycloak（公司 SSO）
AUTH_MODE=keycloak
# openssl rand -base64 32；加密 Auth.js 的 session cookie
AUTH_SECRET=change-me
# 對外網址；Keycloak client 的 redirect URI = $AUTH_URL/api/auth/callback/keycloak
AUTH_URL=https://ailab.example.com
AUTH_KEYCLOAK_ID=qr-ai-lab
AUTH_KEYCLOAK_SECRET=change-me
AUTH_KEYCLOAK_ISSUER=https://sso.example.com/realms/company
# session cookie 壽命（秒）；access token 由 proxy.ts 用 refresh token 自動更新
AUTH_SESSION_MAX_AGE=43200
# 1 = 登入頁多一個摺疊的本地帳號表單（切換期間用）
AUTH_LOCAL_FALLBACK=0
# 只有 nginx 沒有 TLS 時才設（local 模式的登入 cookie 預設 Secure）
# COOKIE_SECURE=0

# 登出後導回的網址（通常不用設，預設 AUTH_URL）
# PUBLIC_URL=https://ailab.example.com
