# /etc/qr-ai-lab/frontend.env — Next.js 前端（systemd EnvironmentFile）。只在伺服器端讀取，不會進瀏覽器。
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
NEXT_TELEMETRY_DISABLED=1
BACKEND_URL=http://127.0.0.1:8000
# 與 qrlab.env 的 AUTH_MODE 一致：local（本地帳號）或 keycloak（公司 SSO）
AUTH_MODE=keycloak
AUTH_SECRET=change-me                              # openssl rand -base64 32；加密 Auth.js 的 session cookie
AUTH_URL=https://ailab.example.com                 # 對外網址；Keycloak client 的 redirect URI = $AUTH_URL/api/auth/callback/keycloak
AUTH_KEYCLOAK_ID=qr-ai-lab
AUTH_KEYCLOAK_SECRET=change-me
AUTH_KEYCLOAK_ISSUER=https://sso.example.com/realms/company
AUTH_SESSION_MAX_AGE=43200                         # session cookie 壽命（秒）；access token 在裡面用 refresh token 自動更新
AUTH_LOCAL_FALLBACK=0                              # 1 = 登入頁多一個摺疊的本地帳號表單（切換期間用）
# COOKIE_SECURE=0                                  # 只有 nginx 沒有 TLS 時才設（local 模式的登入 cookie 預設 Secure）
