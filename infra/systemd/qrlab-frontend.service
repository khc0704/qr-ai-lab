[Unit]
Description=QR AI Lab frontend (Next.js)
After=network-online.target qrlab-backend.service
Wants=network-online.target

[Service]
Type=simple
User=qrlab
Group=qrlab
WorkingDirectory=/opt/qr-ai-lab/frontend
# AUTH_MODE / AUTH_KEYCLOAK_* / BACKEND_URL … live in /etc/qr-ai-lab/frontend.env (template infra/systemd/frontend.env.example)
EnvironmentFile=/etc/qr-ai-lab/frontend.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/npm run start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
