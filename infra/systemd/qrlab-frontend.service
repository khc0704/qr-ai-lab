[Unit]
Description=QR AI Lab frontend (Next.js)
After=network-online.target qrlab-backend.service
Wants=network-online.target

[Service]
Type=simple
User=qrlab
Group=qrlab
WorkingDirectory=/opt/qr-ai-lab/frontend
# PORT / HOSTNAME / AUTH_* / BACKEND_URL live in /etc/qr-ai-lab/frontend.env (template infra/systemd/frontend.env.example);
# `next start` reads PORT and HOSTNAME from the environment.
EnvironmentFile=/etc/qr-ai-lab/frontend.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
# install.sh replaces /usr/local/bin/node with the node binary it found (must be executable by qrlab, i.e. a
# system-wide install, not one user's nvm).
ExecStart=/usr/local/bin/node /opt/qr-ai-lab/frontend/node_modules/next/dist/bin/next start
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
