[Unit]
Description=QR AI Lab scheduler (runs jobs as host processes from the trainer venv)
# The qrlab user's own systemd manager (user@<uid>.service, kept alive by `loginctl enable-linger qrlab`) must be
# up before the scheduler probes `systemd-run --user`; otherwise it would fall back to plain subprocesses
# (no cgroup limits) for its whole lifetime.
After=network-online.target qrlab-backend.service user@1001.service
Wants=network-online.target user@1001.service

[Service]
Type=simple
User=qrlab
Group=qrlab
WorkingDirectory=/opt/qr-ai-lab/backend
EnvironmentFile=/etc/qr-ai-lab/qrlab.env
# XDG_RUNTIME_DIR must point at the user manager (uid of qrlab, e.g. 1001; install.sh rewrites it).
Environment=XDG_RUNTIME_DIR=/run/user/1001
ExecStart=/opt/qr-ai-lab/backend/.venv/bin/python -m app.scheduler
Restart=always
RestartSec=5
# Jobs are started as transient scopes inside the qrlab user's slice, not as children of this unit, so
# restarting the scheduler leaves running jobs alone (it re-attaches to them). No sandboxing here: in the
# subprocess fallback the jobs are children of this process and need the trainer venv, caches and DATA_ROOT.
KillMode=process

[Install]
WantedBy=multi-user.target
