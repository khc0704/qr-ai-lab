[Unit]
Description=QR AI Lab backend API (FastAPI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=qrlab
Group=qrlab
WorkingDirectory=/opt/qr-ai-lab/backend
EnvironmentFile=/etc/qr-ai-lab/qrlab.env
ExecStart=/opt/qr-ai-lab/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
# the API never runs jobs itself; keep it small
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
