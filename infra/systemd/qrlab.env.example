# /etc/qr-ai-lab/qrlab.env — backend 與 scheduler 共用的環境變數（systemd EnvironmentFile）。
# 完整清單與每個變數的意義見 docs/ENVIRONMENT.md。
#
# 注意：systemd 只把「整行」以 # 開頭的當註解，KEY=value 後面的 # 會變成值的一部分。
# 所有說明都寫在獨立的行上，不要在值後面加註解。
APP_ENV=prod
LOG_LEVEL=INFO
CORS_ORIGINS=https://ailab.example.com
DATABASE_URL=mariadb+asyncmy://qr:change-me@127.0.0.1:3306/qr_ai_lab
REDIS_URL=redis://127.0.0.1:6379/0
DATA_ROOT=/srv/qr-ai-lab/data
MODEL_ZOO_ROOT=/srv/qr-ai-lab/data/model_zoo
# 管理員可從這個資料夾匯入權重（NAS / USB 掛載點）
MODEL_ZOO_IMPORT_ROOT=/srv/qr-ai-lab/transfer
# 管理員可從這些內網主機下載權重（逗號分隔；空 = 任何主機，重導向的每一跳都會檢查）
MODEL_ZOO_ALLOWED_HOSTS=mirror.example.com,nexus.example.com
# 單一權重檔上限（MB）
MODEL_ZOO_MAX_MB=20480

# --- 認證：local = 本地帳號（dev / 過渡期）；keycloak = 公司 Keycloak（正式）。
# 前端的 /etc/qr-ai-lab/frontend.env 要設同一個 AUTH_MODE。
AUTH_MODE=keycloak
# openssl rand -hex 32（local 模式簽 token；APP_ENV=prod 會拒絕預設值或少於 32 字元）
AUTH_SECRET=change-me
# openssl rand -hex 32（任務子程序呼叫 /internal/* 的 token）
JOB_TOKEN_SECRET=change-me-too
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"（prod 必填）
DATASET_SECRET_KEY=
# local 模式 token 壽命（分鐘）
ACCESS_TOKEN_MINUTES=720
# token 的 iss；JWKS 從 <issuer>/protocol/openid-connect/certs 取
KEYCLOAK_ISSUER=https://sso.example.com/realms/company
# 讀 resource_access[<client>].roles；沒設 KEYCLOAK_AUDIENCE 時也用來確認 token 的 azp 是本服務
KEYCLOAK_CLIENT_ID=qr-ai-lab
# 設了才驗 aud（Keycloak 要加 audience mapper）
# KEYCLOAK_AUDIENCE=qr-ai-lab
# <Keycloak realm / client role>:<系統角色>；token 沒帶對應 role 時維持 UI 設的角色
KEYCLOAK_ROLE_MAP=superadmin:superadmin,admin:admin
# 第一位 superadmin 的 preferred_username（逗號分隔），登入即為 superadmin
SUPERADMIN_USERNAMES=
# 只在 AUTH_MODE=local 時建立本地帳號；prod 會拒絕預設密碼（keycloak 模式不建立任何本地帳號）
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# --- 任務以主機子程序執行（沒有容器）：auto = 能用 systemd-run 就用 cgroup，否則 subprocess + watchdog
JOB_RUNNER=auto
# systemd-run --user（qrlab 使用者需 loginctl enable-linger）
SYSTEMD_USER=true
TRAINER_DIR=/opt/qr-ai-lab/trainer
# TRAINER_PYTHON=/opt/qr-ai-lab/trainer/.venv/bin/python
# true = 排程器跑在 backend 程序內（單機小型部署可省 Redis；此時 qrlab-scheduler.service 不要啟用）
SCHEDULER_EMBEDDED=false
MEMORY_WATCHDOG=true
# 獨占型任務：顯存已被用超過 10% 的 GPU 不排
GPU_BUSY_THRESHOLD=0.10
# 依顯存共用 GPU 時每張保留給驅動 / context 的量（MB）
GPU_RESERVE_MB=512
# 剛啟動的任務在這段時間內（秒）以「申請量 − 實測量」計入保留；在驅動看見它的程序之前整個申請量都保留
GPU_WARMUP_S=120
# superadmin「重置裝置」用；要在 sudoers 允許 qrlab 免密碼執行
# GPU_RESET_COMMAND=sudo -n nvidia-smi --gpu-reset -i {index}
# 使用率歷史取樣間隔（秒）與保留天數
USAGE_SAMPLE_INTERVAL_S=30
USAGE_RETENTION_DAYS=90
INTERNAL_BACKEND_URL=http://127.0.0.1:8000
SCHEDULER_INTERVAL_S=3
# 一次性上傳與工具上傳的上限（MB）與暫存壽命（分鐘）
UPLOAD_MAX_MB=2048
UPLOAD_TTL_MINUTES=60
# 前處理抽樣預覽（即時）的秒數上限
PREVIEW_TIMEOUT_S=30
# 任務 log 超過這個大小（MB）會就地截斷，只留最後 1/4
LOG_MAX_MB=50
# 「任務預設」第一次寫進資料庫時的逾時（分鐘）；之後請在管理員後台調整
DEFAULT_JOB_TIMEOUT_MINUTES=240
