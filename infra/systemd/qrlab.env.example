# /etc/qr-ai-lab/qrlab.env — backend 與 scheduler 共用的環境變數（systemd EnvironmentFile）。
# 完整清單見 backend/app/core/config.py 與 docs/ARCHITECTURE.md §13。
APP_ENV=prod
LOG_LEVEL=INFO
PUBLIC_URL=https://ailab.example.com
CORS_ORIGINS=https://ailab.example.com
DATABASE_URL=mariadb+asyncmy://qr:change-me@127.0.0.1:3306/qr_ai_lab
REDIS_URL=redis://127.0.0.1:6379/0
DATA_ROOT=/srv/qr-ai-lab/data
MODEL_ZOO_ROOT=/srv/qr-ai-lab/data/model_zoo
MODEL_ZOO_IMPORT_ROOT=/srv/qr-ai-lab/transfer      # 管理員可從這個資料夾匯入權重（NAS / USB 掛載點）
MODEL_ZOO_ALLOWED_HOSTS=mirror.example.com,nexus.example.com   # 管理員可從這些內網主機下載權重
# --- 認證：local = 本地帳號（dev / 過渡期）；keycloak = 公司 Keycloak（正式）。前端的 /etc/qr-ai-lab/frontend.env 要設同一個 AUTH_MODE
AUTH_MODE=keycloak
AUTH_SECRET=change-me                              # openssl rand -hex 32（local 模式簽 token；keycloak 模式仍用於 Fernet 退路）
JOB_TOKEN_SECRET=change-me-too                     # openssl rand -hex 32
DATASET_SECRET_KEY=                                # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEYCLOAK_ISSUER=https://sso.example.com/realms/company    # token 的 iss；JWKS 從 <issuer>/protocol/openid-connect/certs 取
KEYCLOAK_CLIENT_ID=qr-ai-lab                       # 讀 resource_access[<client>].roles；也用於 KEYCLOAK_AUDIENCE 驗證（選用）
# KEYCLOAK_AUDIENCE=qr-ai-lab                      # 設了才驗 aud（Keycloak 要加 audience mapper）
KEYCLOAK_ROLE_MAP=superadmin:superadmin,admin:admin   # <Keycloak realm / client role>:<系統角色>；token 沒帶對應 role 時維持 UI 設的角色
SUPERADMIN_USERNAMES=                              # 第一位 superadmin 的 preferred_username（逗號分隔），登入即為 superadmin
SEED_SUPERADMIN_PASSWORD=superadmin1234            # 只在 local 模式 / seed 時使用
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=user1234
# 任務以主機子程序執行（沒有容器）：auto = 能用 systemd-run 就用 cgroup，否則 subprocess + watchdog
JOB_RUNNER=auto
SYSTEMD_USER=true                                  # systemd-run --user（qrlab 使用者需 loginctl enable-linger）
TRAINER_DIR=/opt/qr-ai-lab/trainer
# TRAINER_PYTHON=/opt/qr-ai-lab/trainer/.venv/bin/python
SCHEDULER_EMBEDDED=false                           # true = 排程器跑在 backend 程序內（單機小型部署可省 Redis）
MEMORY_WATCHDOG=true
GPU_BUSY_THRESHOLD=0.10                            # 獨占型任務：顯存已被用超過 10% 的 GPU 不排
GPU_RESERVE_MB=512                                 # 依顯存共用 GPU 時每張保留給驅動 / context 的量
# GPU_RESET_COMMAND=sudo -n nvidia-smi --gpu-reset -i {index}   # superadmin「重置裝置」用；要在 sudoers 允許 qrlab 免密碼執行
USAGE_SAMPLE_INTERVAL_S=30                         # 使用率歷史取樣間隔
USAGE_RETENTION_DAYS=90
TOOL_PROCESS_TIMEOUT_S=600                         # 資料前處理服務整檔執行的上限
INTERNAL_BACKEND_URL=http://127.0.0.1:8000
SCHEDULER_INTERVAL_S=3
UPLOAD_MAX_MB=2048
UPLOAD_TTL_MINUTES=60
LOG_MAX_MB=50
DEFAULT_JOB_TIMEOUT_MINUTES=240
