# 複製為 infra/.env 後填入；此檔不含真實密碼。
# --- MariaDB（docker compose 使用）---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=qr_ai_lab
MARIADB_USER=qr
MARIADB_PASSWORD=change-me
MARIADB_PORT=3306
# --- Redis ---
REDIS_PORT=6379

# --- backend / scheduler（backend 建立後使用；完整清單見 docs/ARCHITECTURE.md §13）---
# DATABASE_URL=mariadb+asyncmy://qr:change-me@localhost:3306/qr_ai_lab
# REDIS_URL=redis://localhost:6379/0
# DATA_ROOT=/srv/qr-ai-lab/data
# DATA_ROOT_HOST=/srv/qr-ai-lab/data
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/company
# KEYCLOAK_AUDIENCE=qr-ai-lab
# DATASET_SECRET_KEY=            # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JOB_TOKEN_SECRET=              # openssl rand -hex 32
# TRAINER_IMAGE=qr-ai-lab/trainer:dev
# UPLOAD_MAX_MB=2048
# UPLOAD_TTL_MINUTES=60

# --- frontend（Auth.js + Keycloak；接上登入後使用）---
# AUTH_SECRET=                   # openssl rand -base64 32
# AUTH_KEYCLOAK_ID=qr-ai-lab
# AUTH_KEYCLOAK_SECRET=
# AUTH_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/company
# BACKEND_URL=http://localhost:8000
