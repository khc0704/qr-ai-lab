# 複製為 infra/.env 後填入；此檔不含真實密碼。
# --- MariaDB（docker compose 使用）---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=qr_ai_lab
MARIADB_USER=qr
MARIADB_PASSWORD=change-me
MARIADB_PORT=3306
# --- Redis ---
REDIS_PORT=6379

# --- backend / scheduler（profile app；完整清單見 docs/ARCHITECTURE.md §13）---
APP_ENV=prod
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
DATA_ROOT_HOST=/srv/qr-ai-lab/data      # 主機上的資料目錄（產物、log、暫存輸入、model_zoo/）
AUTH_MODE=local                          # 過渡期本地帳號；接 Keycloak 時改 keycloak 並填下方 KEYCLOAK_*
AUTH_SECRET=                             # openssl rand -hex 32
SEED_ADMIN_PASSWORD=admin1234            # 第一次 `app.cli seed` 建立 admin / user 用；之後用 set-password 改
SEED_USER_PASSWORD=user1234
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/company
# KEYCLOAK_AUDIENCE=qr-ai-lab
DATASET_SECRET_KEY=                      # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOB_TOKEN_SECRET=                        # openssl rand -hex 32
TRAINER_IMAGE=qr-ai-lab/trainer:dev
SCHEDULER_INTERVAL_S=3
UPLOAD_MAX_MB=2048
UPLOAD_TTL_MINUTES=60
LOG_MAX_MB=50
DEFAULT_JOB_TIMEOUT_MINUTES=240

# --- frontend（Auth.js + Keycloak；接上登入後使用）---
# AUTH_KEYCLOAK_ID=qr-ai-lab
# AUTH_KEYCLOAK_SECRET=
# AUTH_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/company
# BACKEND_URL=http://localhost:8000
