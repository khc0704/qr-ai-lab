# 複製為 infra/.env 後填入；此檔不含真實密碼。只有 MariaDB / Redis 跑在 docker compose，
# backend / scheduler / frontend 是主機上的 systemd 服務（設定在 infra/systemd/qrlab.env）。
# 公司的 image 鏡像，例 mirror.example.com/（含結尾斜線）；留空 = Docker Hub
DOCKER_REGISTRY=
# --- MariaDB ---
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=qr_ai_lab
MARIADB_USER=qr
MARIADB_PASSWORD=change-me
MARIADB_PORT=3307
# --- Redis ---
REDIS_PORT=6380
# --- 資料目錄（主機目錄 bind mount，不用 docker volume）---
# 相對路徑以 infra/ 為基準（預設 infra/data/*，已在 .gitignore）；正式環境建議寫絕對路徑，例如 /srv/qr-ai-lab/mariadb
MARIADB_DATA_DIR=./data/mariadb
REDIS_DATA_DIR=./data/redis
