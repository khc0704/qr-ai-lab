{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/design_lint.py\" --hook",
            "timeout": 20,
            "statusMessage": "design-lint: checking design tokens"
          }
        ]
      }
    ]
  }
}
