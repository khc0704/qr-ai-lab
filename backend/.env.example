# backend/.env — copy to .env for local development. Production values live in /etc/qr-ai-lab/qrlab.env
# (see infra/systemd/qrlab.env.example).
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# SQLite for a quick start (tables auto-created + accounts seeded in dev); MariaDB for real:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=mariadb+asyncmy://qr:change-me@localhost:3306/qr_ai_lab

# Single-process dev: the scheduler loop runs inside the API process and no Redis is needed.
SCHEDULER_EMBEDDED=true
# Two processes (uvicorn + `python -m app.scheduler`) need Redis so live job events reach the API:
# REDIS_URL=redis://localhost:6379/0

DATA_ROOT=./data
# MODEL_ZOO_ROOT=./data/model_zoo
# MODEL_ZOO_IMPORT_ROOT=/mnt/transfer          # admins may import weights from files under this folder
# MODEL_ZOO_ALLOWED_HOSTS=mirror.example.com   # admins may fetch weights from these intranet hosts

# Interim local accounts (auth_mode=local). Switch to keycloak later.
AUTH_MODE=local
AUTH_SECRET=change-me-$(openssl rand -hex 16)
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=user1234
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/company
# KEYCLOAK_AUDIENCE=qr-ai-lab

# DATASET_SECRET_KEY=   # Fernet key for data-source credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOB_TOKEN_SECRET=change-me-too

# Jobs are host processes from the trainer venv (no containers).
JOB_RUNNER=auto                 # auto: systemd-run cgroup scopes when available, else subprocess + watchdog
TRAINER_DIR=../trainer
# TRAINER_PYTHON=../trainer/.venv/bin/python
MEMORY_WATCHDOG=true
GPU_BUSY_THRESHOLD=0.10
INTERNAL_BACKEND_URL=http://localhost:8000
SCHEDULER_INTERVAL_S=3
UPLOAD_MAX_MB=2048
UPLOAD_TTL_MINUTES=60
