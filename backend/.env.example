# backend/.env — copy to .env for local development (python-dotenv). Production values live in
# /etc/qr-ai-lab/qrlab.env (template infra/systemd/qrlab.env.example); every variable is explained in
# docs/ENVIRONMENT.md. Comments are on their own lines so the same file also works as a systemd EnvironmentFile.
APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# external path prefix stripped by nginx in production (e.g. /ai-lab-api); empty in dev
# ROOT_PATH=

# SQLite for a quick start (tables auto-created + accounts seeded in dev); MariaDB for real:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=mariadb+asyncmy://qr:change-me@localhost:3307/qr_ai_lab

# Single-process dev: the scheduler loop runs inside the API process and no Redis is needed.
SCHEDULER_EMBEDDED=true
# Two processes (uvicorn + `python -m app.scheduler`) need Redis so live job events reach the API:
# REDIS_URL=redis://localhost:6380/0

DATA_ROOT=./data
# MODEL_ZOO_ROOT=./data/model_zoo
# admins may import weights from files under this folder
# MODEL_ZOO_IMPORT_ROOT=/mnt/transfer
# admins may fetch weights from these intranet hosts (every redirect hop is checked)
# MODEL_ZOO_ALLOWED_HOSTS=mirror.example.com
# MODEL_ZOO_MAX_MB=20480

# Auth. local = username/password accounts seeded below (dev / interim); keycloak = the company realm (prod).
# The frontend's AUTH_MODE must match. Roles: superadmin | admin | user (app/core/permissions.py).
AUTH_MODE=local
# dev only: any string works; APP_ENV=prod refuses defaults and anything shorter than 32 characters
# (generate one with: openssl rand -hex 32)
AUTH_SECRET=dev-secret-change-me
# ACCESS_TOKEN_MINUTES=720
SEED_SUPERADMIN_PASSWORD=superadmin1234
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=user1234
# KEYCLOAK_ISSUER=https://sso.example.com/realms/company
# KEYCLOAK_CLIENT_ID=qr-ai-lab
# only verified when set (otherwise the token's azp must be KEYCLOAK_CLIENT_ID)
# KEYCLOAK_AUDIENCE=qr-ai-lab
# Keycloak supplies identity only; roles live in users.role (/admin/users). Opt-in override: <keycloak role>:<system role>
# KEYCLOAK_ROLE_MAP=
# the one and only superadmin (local username / Keycloak preferred_username); empty = nobody is superadmin
SUPERADMIN_USERNAME=superadmin
# deprecated spelling (comma list, only the first entry counts): use SUPERADMIN_USERNAME
# SUPERADMIN_USERNAMES=

# Fernet key for data-source credentials (derived from AUTH_SECRET in dev when unset; prod must set it):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DATASET_SECRET_KEY=
JOB_TOKEN_SECRET=dev-job-secret-change-me

# Jobs are host processes from the trainer venv (no containers).
# auto: systemd-run cgroup scopes when available, else subprocess + watchdog
JOB_RUNNER=auto
# SYSTEMD_USER=true
TRAINER_DIR=../trainer
# TRAINER_PYTHON=../trainer/.venv/bin/python
MEMORY_WATCHDOG=true
# exclusive jobs skip a GPU whose memory is already >10% used
GPU_BUSY_THRESHOLD=0.10
# kept free per GPU when packing VRAM-sharing jobs
GPU_RESERVE_MB=512
# a fresh job keeps (request − measured) reserved this long; before the driver sees it the whole request stays reserved
GPU_WARMUP_S=120
# GPU_RESET_COMMAND=sudo -n nvidia-smi --gpu-reset -i {index}
# usage history sampler (admin → 使用率歷史)
USAGE_SAMPLE_INTERVAL_S=30
USAGE_RETENTION_DAYS=90
INTERNAL_BACKEND_URL=http://localhost:8000
SCHEDULER_INTERVAL_S=3
UPLOAD_MAX_MB=2048
UPLOAD_TTL_MINUTES=60
# PREVIEW_TIMEOUT_S=30
# LOG_MAX_MB=50
# DEFAULT_JOB_TIMEOUT_MINUTES=240
