# backend/.env — copy to .env for local development. Production values live in infra/.env (docker compose).
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# SQLite for a quick start (tables auto-created + accounts seeded in dev); MariaDB for real:
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=mariadb+asyncmy://qr:change-me@localhost:3306/qr_ai_lab

# Redis for live job events (optional in dev: unset → in-process bus, single process only)
# REDIS_URL=redis://localhost:6379/0

DATA_ROOT=./data
# DATA_ROOT_HOST=/srv/qr-ai-lab/data   # host path, needed only when the scheduler runs inside docker
# MODEL_ZOO_ROOT=./data/model_zoo

# Interim local accounts (auth_mode=local). Switch to keycloak later.
AUTH_MODE=local
AUTH_SECRET=change-me-$(openssl rand -hex 16)
SEED_ADMIN_PASSWORD=admin1234
SEED_USER_PASSWORD=user1234
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/company
# KEYCLOAK_AUDIENCE=qr-ai-lab

# DATASET_SECRET_KEY=   # Fernet key for data-source credentials: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOB_TOKEN_SECRET=change-me-too

# Scheduler
JOB_RUNNER=subprocess           # docker on the GPU server; subprocess runs `python -m trainer` locally (CPU families)
TRAINER_IMAGE=qr-ai-lab/trainer:dev
TRAINER_DIR=../trainer
INTERNAL_BACKEND_URL=http://localhost:8000
SCHEDULER_INTERVAL_S=3
UPLOAD_MAX_MB=2048
UPLOAD_TTL_MINUTES=60
